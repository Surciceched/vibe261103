# 텍스트 파일은 저장소에 LF로 보관
.gitattributes text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.json   text eol=lf
*.svg    text eol=lf
*.md     text eol=lf
*.xml    text eol=lf
*.txt    text eol=lf

# 바이너리: 줄바꿈 변환 금지 (변환되면 PDF가 깨짐)
*.pdf    binary
*.png    binary
*.jpg    binary
*.webp   binary
*.ico    binary
